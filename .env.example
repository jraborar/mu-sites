# mu-sites reads the SHARED Supabase project (same one mu-wp-staging / mu-deployment
# / mu-vrt use). It is READ-ONLY — it never writes to any table. Reads go through the
# service-role key because the shared tables have no RLS policies yet.
#
# Copy this to .env.local and fill in the values from the shared project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
